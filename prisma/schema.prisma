generator client {
  provider            = "prisma-client"
  output              = "../libs/prisma/src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CustomerTier {
  standard
  premium
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

model Customer {
  id           String       @id
  name         String
  email        String       @unique
  tier         CustomerTier @default(standard)
  passwordHash String
  createdAt    DateTime     @default(now())
  orders       Order[]
  memory       UserMemory?
}

model Order {
  id          String      @id
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  items       Json
  total       Decimal     @db.Decimal(10, 2)
  status      OrderStatus
  createdAt   DateTime
  shippedAt   DateTime?
  deliveredAt DateTime?

  @@index([customerId])
}

/// Long-term facts the agent remembers about a customer, across threads.
model UserMemory {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id])
  facts      String[]
  updatedAt  DateTime @updatedAt
}
