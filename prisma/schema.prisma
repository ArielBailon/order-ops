generator client {
  provider            = "prisma-client"
  output              = "../libs/prisma/src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CustomerTier {
  standard
  premium
}

enum UserRole {
  customer
  operator
}

enum RefundStatus {
  pending_approval
  approved
  rejected
  auto_rejected
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

model Customer {
  id           String       @id
  name         String
  email        String       @unique
  tier         CustomerTier @default(standard)
  role         UserRole     @default(customer)
  passwordHash String
  createdAt    DateTime     @default(now())
  orders       Order[]
  memory       UserMemory?
  refunds      RefundRequest[]
}

model Order {
  id          String      @id
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  items       Json
  total       Decimal     @db.Decimal(10, 2)
  status      OrderStatus
  createdAt   DateTime
  shippedAt   DateTime?
  deliveredAt DateTime?
  refunds     RefundRequest[]

  @@index([customerId])
}

/// Long-term facts the agent remembers about a customer, across threads.
model UserMemory {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id])
  facts      String[]
  updatedAt  DateTime @updatedAt
}

/// A customer's refund request. At most one per order may be pending_approval (partial unique index in the migration).
model RefundRequest {
  id             String       @id
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id])
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  amount         Decimal      @db.Decimal(10, 2)
  reason         String
  status         RefundStatus
  decidedBy      String?
  decisionReason String?
  /// Checkpoint thread key (customerId:threadId) used to resume the paused chat thread; null before 4b.
  threadKey      String?
  createdAt      DateTime     @default(now())

  @@index([customerId])
  @@index([orderId])
}
