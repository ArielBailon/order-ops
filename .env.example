# Postgres + pgvector (docker compose)
DATABASE_URL="postgresql://orderops:orderops@localhost:5432/orderops?schema=public"

# Auth: HS256 secret shared by all apps, at least 32 characters
JWT_SECRET=

# Service wiring (defaults shown)
PORT=3000
ORDERS_SERVICE_PORT=3001
CUSTOMERS_SERVICE_PORT=3002
CUSTOMERS_SERVICE_URL=http://127.0.0.1:3002
ORDERS_SERVICE_URL=http://127.0.0.1:3001

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AWS Bedrock
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
