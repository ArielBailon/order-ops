# Postgres + pgvector (docker compose)
DATABASE_URL="postgresql://orderops:orderops@localhost:5432/orderops?schema=public"

# Auth: HS256 secret shared by all apps, at least 32 characters
JWT_SECRET=

# Service wiring (defaults shown)
PORT=3000
ORDERS_SERVICE_PORT=3001
CUSTOMERS_SERVICE_PORT=3002
CUSTOMERS_SERVICE_URL=http://127.0.0.1:3002
ORDERS_SERVICE_URL=http://127.0.0.1:3001

# LLM providers (required). Chat calls try Anthropic, then OpenAI, then Bedrock; OpenAI
# also serves embeddings. Each tier (cheap: routing/memory, strong: answers) is defined in
# apps/orderops-agent/src/models/providers.ts
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AWS Bedrock (optional): enabled as the last failover only when AWS_REGION is set.
# Without a key pair the AWS default credential chain is used.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Langfuse spans (optional). Set both keys to send metadata-only span trees to Langfuse
# Cloud; leave both empty to keep them off. No message text, tool data or tokens are sent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to https://cloud.langfuse.com (EU); use https://us.cloud.langfuse.com for US projects.
LANGFUSE_BASE_URL=
