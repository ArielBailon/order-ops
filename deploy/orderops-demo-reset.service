[Unit]
Description=Nightly OrderOps demo data reset
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=ec2-user
# Assumes the repository is cloned at /home/ec2-user/order-ops (see docs/deploy.md).
WorkingDirectory=/home/ec2-user/order-ops
ExecStart=/home/ec2-user/order-ops/deploy/demo-reset.sh
