# Production compose (docker-compose.prod.yml). Copy to `.env.production` on the host and
# run: docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# Compose stops with a clear message when a required value below is missing.

# Public hostname Caddy serves and gets a TLS certificate for (use `localhost` to rehearse locally)
API_DOMAIN=

# Postgres password. Must be URL-safe (letters and digits, for example `openssl rand -hex 24`)
# because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=

# Auth: HS256 secret shared by all apps, at least 32 characters
JWT_SECRET=

# LLM providers (both required, as in the dev setup)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AWS Bedrock (optional last failover). Leave empty to keep it off. The containers never get
# AWS access keys: on EC2 the instance IAM role supplies credentials.
AWS_REGION=

# Image names for the three apps (defaults build and tag them locally)
REGISTRY=orderops
TAG=local

# CloudWatch Logs (docker-compose.aws.yml overlay only). The group must already exist.
LOG_REGION=us-east-1
LOG_GROUP=/orderops/prod
