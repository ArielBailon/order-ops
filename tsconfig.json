{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@app/auth": [
        "./libs/auth/src/index.ts"
      ],
      "@app/auth/*": [
        "./libs/auth/src/*"
      ],
      "@app/prisma": [
        "./libs/prisma/src/index.ts"
      ],
      "@app/prisma/*": [
        "./libs/prisma/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/orderops-agent/tsconfig.app.json"
    },
    {
      "path": "./apps/orders-service/tsconfig.app.json"
    },
    {
      "path": "./apps/customers-service/tsconfig.app.json"
    }
  ]
}