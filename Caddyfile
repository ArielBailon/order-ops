# TLS is automatic for a public API_DOMAIN (Let's Encrypt); `localhost` gets Caddy's
# internal CA, which is what the local rehearsal uses.
{$API_DOMAIN} {
	# flush_interval -1 sends every SSE event to the client as soon as the gateway writes it.
	reverse_proxy orderops-agent:3000 {
		flush_interval -1
	}
}
