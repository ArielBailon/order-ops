{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/orderops-agent/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/orderops-agent/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/orderops-agent",
  "projects": {
    "customers-service": {
      "type": "application",
      "root": "apps/customers-service",
      "entryFile": "main",
      "sourceRoot": "apps/customers-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/customers-service/tsconfig.app.json"
      }
    },
    "orderops-agent": {
      "type": "application",
      "root": "apps/orderops-agent",
      "entryFile": "main",
      "sourceRoot": "apps/orderops-agent/src",
      "compilerOptions": {
        "tsConfigPath": "apps/orderops-agent/tsconfig.app.json"
      }
    },
    "orders-service": {
      "type": "application",
      "root": "apps/orders-service",
      "entryFile": "main",
      "sourceRoot": "apps/orders-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/orders-service/tsconfig.app.json"
      }
    }
  }
}