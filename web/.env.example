# Copy to .env.local. These are read only by the console server, never by the browser.
# Gateway base URL.
API_URL=http://localhost:3000
# Password of the seeded demo customers (the seed uses orderops-dev-password).
DEMO_PASSWORD=

# Optional: your Langfuse project URL, for "Open in Langfuse" on the dashboard traces.
# Example: https://us.cloud.langfuse.com/project/<project-id>
LANGFUSE_PROJECT_URL=
